class _NutritionCardState extends State<NutritionCard> {
  late Future<NutritionTargets> _targetsFuture;

  @override
  void initState() {
    super.initState();
    _targetsFuture = TargetCalorieCalculator.calculate();
  }

  void _refreshTargets() {
    setState(() {
      _targetsFuture = TargetCalorieCalculator.calculate();
    });

                  width: 1.5,
                  dashArray: const [5, 3],
                  enableTooltip: true,
                  markerSettings: const MarkerSettings(isVisible: false),
                ),
                // Water bars
                ColumnSeries<WaterPoint, DateTime>(
                  dataSource: widget.points,
                  xValueMapper: (p, _) => p.date,
                  yValueMapper: (p, _) => p.liters,
                  pointColorMapper: (p, _) => p.liters >= p.target
